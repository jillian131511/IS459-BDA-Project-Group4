# Copy to infra/config.env and edit. All scripts read this file.
export AWS_REGION=us-east-1
export BUCKET=is459-g2-aml-CHANGE-ME          # globally unique, lowercase
export PIPELINE_ROLE=LabRole                   # Learner Lab role used by Glue + Step Functions
export INSTANCE_PROFILE=LabInstanceProfile     # instance profile for the ingestion EC2
# Normal AWS account (not Learner Lab): run `bash infra/create_roles.sh`, then use
#   PIPELINE_ROLE=aml-pipeline-role   INSTANCE_PROFILE=aml-pipeline-profile
export EMR_SERVICE_ROLE=EMR_DefaultRole        # Learner Lab EMR roles (create with: aws emr create-default-roles)
export EMR_EC2_PROFILE=EMR_EC2_DefaultRole
export EMR_RELEASE=emr-7.5.0                   # Spark 3.5
export ETL_JOB=aml-etl-transactions
export ATHENA_JOB=aml-athena-runner
export CRAWLER=aml-curated-crawler
export STATE_MACHINE=aml-pipeline
export ETL_WORKER_TYPE=G.1X                    # 4 vCPU / 16 GB per worker
export ETL_WORKERS=4                           # HI-Small: 4 ; HI-Large: 10
