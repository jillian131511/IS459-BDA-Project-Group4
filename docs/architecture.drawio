<mxfile host="app.diagrams.net"><diagram name="Follow the Money - AML pipeline" id="aml"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="880" background="#F8FAFC" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="FOLLOW THE MONEY · end-to-end AML pipeline on AWS (IS459 · Section G2 · Group 4)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Batch layer learns where risk is (BQ1, BQ2) · speed layer applies it to every new transaction · one Step Functions workflow runs it all" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1000" height="64" as="geometry"/></mxCell><mxCell id="n5" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="316" y="98" width="48" height="48" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;AWS Step Functions&lt;/b&gt; &amp;nbsp; ETL → crawler → Athena BQ1 → (EMR BQ2 ∥ benchmark) · retries · auto-terminates EMR on failure" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#4C1D95;" vertex="1"