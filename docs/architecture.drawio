274" height="75" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;curated/&lt;/b&gt;&lt;br&gt;Parquet · Snappy · USD-normalised&lt;br&gt;partitioned variant / txn_date&lt;br&gt;&lt;font color='#64748B'&gt;+ dq_report · fx_rates · patterns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="318" y="355" width="274" height="95" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;analytics/&lt;/b&gt;&lt;br&gt;BQ1 segment risk · BQ2 watchlist&lt;br&gt;evaluation · run_log (cost)&lt;br&gt;&lt;font color='#64748B'&gt;Athena tables via partition projection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="318" y="465" width="274" height="95" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;streaming/alerts/&lt;/b&gt;&lt;br&gt;micro-batched live alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="318" y="575" width="274" height="60" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;AWS Glue ETL (Spark)&lt;/b&gt;&lt;br&gt;explicit schema · dedupe · DQ report&lt;br&gt;FX implied from data · features&lt;br&gt;&lt;font color='#64748B'&gt;CSV → partitioned Parquet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="300" height="110" as="geometry"/></mxCell><mxCell id="n23" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="40" height="40" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Glue Crawler + Data Catalog&lt;/b&gt;&lt;br&gt;tables + partitions for Athena" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="300" height="80" as="geometry"/></mxCell><mxCell id="n25" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue_data_catalog;" vertex="1" parent="1"><mxGeometry x="900" y="412" width="40" height="40" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;BQ1 · Amazon Athena&lt;/b&gt;&lt;br&gt;Where is the risk? segment lift,&lt;br&gt;Wilson lower bound, capture curve,&lt;br&gt;time profile, bank corridors&lt;br&gt;&lt;font color='#64748B'&gt;serverless SQL · UNLOAD → Parquet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#67E8F9;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="990" y="205" width="290" height="140" as="geometry"/></mxCell><mxCell id="n27" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;" vertex="1" parent="1"><mxGeometry x="1230" y="215" width="40" height="40" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;BQ2 · Amazon EMR (Spark)&lt;/b&gt;&lt;br&gt;Who is moving it? fan-in/out,&lt;br&gt;2–4 hop cycles, scatter-gather,&lt;br&gt;weight-of-evidence scorecard +&lt;br&gt;plain-English reasons, holdout eval&lt;br&gt;&lt;font color='#64748B'&gt;transient cluster · created + killed by SFN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="990" y="370" width="290" height="165" as="geometry"/></mxCell><mxCell id="n29" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.emr;" vertex="1" parent="1"><mxGeometry x="1230" y="380" width="40" height="40" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Streamlit dashboard&lt;/b&gt;&lt;br&gt;• Alert-budget optimiser&lt;br&gt;• Risk heatmaps&lt;br&gt;• Investigator watchlist&lt;br&gt;• Money-trail graph explorer&lt;br&gt;• Live alert feed&lt;br&gt;• Cost / benchmark evidence&lt;br&gt;&lt;br&gt;&lt;font color='#64748B'&gt;boto3 → Athena, small aggregated results only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1320" y="205" width="250" height="230" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;AML monitoring team (BQ1)&lt;br&gt;Financial-crime investigators (BQ2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=6;arcSize=8;fontColor=#